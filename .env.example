# EcoTrack Environment Configuration
# Local SQLite telemetry API
BACKEND_URL=http://localhost:5000
# Optional Python database override: ECOTRACK_SQLITE_DB_PATH
# Monitoring stores additive tables in the same local database.
# Optional cloud backup, disabled until its migration has been reviewed/applied:
# ECOTRACK_MONITOR_SYNC=1
# Administrator credential is generated locally; do not put it in renderer code.
# Optional override (at least 32 random characters): ECOTRACK_MONITOR_ADMIN_TOKEN
# Experimental NREL temperature-only energy estimates are enabled by request.
# Set to 0 to disable them; laboratory validation does not establish field accuracy.
# ECOTRACK_SENSOR_REFERENCE_ESTIMATES=1

# Supabase (Cloud Database for Auth, Buildings, Floors, Rooms, Nodes, Rules, Notifications)
# Replace with your project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
